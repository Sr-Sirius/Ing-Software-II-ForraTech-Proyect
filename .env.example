# ─────────────────────────────────────────────────────────────────────────────
# ForraTech · variables de entorno
# Copia este archivo como .env (NO lo subas a GitHub; .env está en .gitignore).
# En Render, crea las mismas variables en: servicio → Environment.
# ─────────────────────────────────────────────────────────────────────────────

# Clave para firmar las cookies de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Contraseña del panel interno /soporte (bandeja de correo, Telegram, diagnóstico)
ADMIN_PASSWORD=

# Hosts públicos del sitio (separados por coma). El primero se usa en los mensajes del bot.
PUBLIC_HOSTS=ing-software-ii-forratech-proyect.onrender.com

# ── Telegram (mensajería sincrónica / integración móvil) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ID del grupo de soporte del equipo (escribe /id en el grupo para obtenerlo; suele ser negativo)
TELEGRAM_TEAM_CHAT_ID=
# Texto aleatorio que Telegram envía en cada webhook (genéralo igual que SECRET_KEY)
TELEGRAM_WEBHOOK_SECRET=

# ── XMPP (Converse.js) ── valores por defecto: servidor público conversejs.org
XMPP_DOMAIN=conversejs.org
XMPP_BOSH_URL=https://conversejs.org/http-bind/
XMPP_ROOM=forratech-soporte@conference.conversejs.org

# ── Correo (mensajería asincrónica IMAP/POP3) ──
# Buzón de soporte y su CONTRASEÑA DE APLICACIÓN de Google (no la contraseña normal)
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
POP3_HOST=pop.gmail.com
POP3_PORT=995

# ── Solo en local ──
# HTTPS local con el certificado de scripts/generar_certificado_local.sh
# LOCAL_TLS_CERT=certs/localhost.crt
# LOCAL_TLS_KEY=certs/localhost.key
